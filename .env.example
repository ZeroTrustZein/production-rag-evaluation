# Production RAG Evaluation Environment Configuration
# Copy this file to .env and configure appropriately

# Environment Mode: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Semantic Caching
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_MAX_ENTRIES=5000
SEMANTIC_CACHE_TTL_SECONDS=86400

# Hallucination Detection Thresholds
HALLUCINATION_SENSITIVITY=0.75
NUMERICAL_TOLERANCE_PCT=0.01
CLAIM_VERIFICATION_THRESHOLD=0.80

# Financial Risk Metrics & Stress Testing
RISK_FREE_RATE=0.045
MONTE_CARLO_SIMULATIONS=1000
CONFIDENCE_INTERVAL=0.95

# Feature Store & Columnar Parquet Storage
FEATURE_STORE_BACKEND=parquet
FEATURE_STORE_BASE_PATH=./data/feature_store
FEATURE_STORE_BUFFER_SIZE=1000
FEATURE_STORE_FLUSH_INTERVAL_SECONDS=10.0
FEATURE_STORE_COMPRESSION=snappy

# Optional LLM / Embedding Providers (Mock/Local by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
